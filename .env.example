# ---------------------------------------------------------------------------
# Dream Memory — example environment file.
# Copy to `.env` and fill in. NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

# --- Service -----------------------------------------------------------------
DREAM_ENV=local
DREAM_LOG_LEVEL=INFO
DREAM_LOG_JSON=true
# Optional YAML file that overlays the tuning sections (see config/dream.yaml).
DREAM_CONFIG_FILE=config/dream.yaml
# Comma separated API keys accepted on the X-API-Key header. Empty = auth disabled.
DREAM_API_KEYS=

# --- MongoDB (canonical source of truth) -------------------------------------
DREAM_MONGODB_URI=mongodb://localhost:27017
DREAM_MONGODB_DATABASE=memdream

# --- Queue -------------------------------------------------------------------
# inline | database
#
# Where *background synthesis* runs. Nothing on the user's path goes through
# here - remember, recall, supersede and merge are synchronous in the API.
#
# `inline` is the default: synthesis runs in a bounded pool of tasks inside the
# API. One process, no broker, nothing else to deploy.
#
# `database` moves it to a separate worker claiming rows from the jobs table -
# still no broker. Use it only for several API replicas sharing one queue.
DREAM_QUEUE_PROVIDER=inline

# How many synthesis jobs this process runs at once, and how many may wait.
DREAM_DREAM__SYNTHESIS__MAX_CONCURRENT=2
DREAM_DREAM__SYNTHESIS__MAX_QUEUED=100

# --- Consolidation -----------------------------------------------------------
# Record which memories each search returned, so consolidation can later tell
# what is still earning its place from what nothing has needed in months.
# Collects only - nothing reads it yet, and decay thresholds set against a week
# of data would be guesses.
DREAM_TRACK_RECALL=true

# Retire memories whose validity window has closed. "Retire" means a status
# change to `expired`: the row is kept and leaves the search index, so being
# wrong costs a flip rather than a row. Runs before each synthesis pass, needs
# no model and no embedding.
DREAM_DREAM__CONSOLIDATION__ENABLED=true
DREAM_DREAM__CONSOLIDATION__MAX_PER_RUN=500

# The nightly clock. An asyncio task inside the API process - not a cron
# container - that walks every partition once a day and consolidates each one.
# A user who stops talking never triggers synthesis, and that is exactly the
# account accumulating memories that have quietly stopped being true.
DREAM_DREAM__CONSOLIDATION__SCHEDULE_ENABLED=true
DREAM_DREAM__CONSOLIDATION__SCHEDULE_HOUR_UTC=0

# --- Recall decay (OFF - turn on only after measuring) -----------------------
# Retiring a memory because nothing has recalled it is a judgement, not a fact.
# The evidence is `lastRecalledAt`, which only accumulates from the day recall
# tracking is switched on - before that every row reads `null`, which is
# indistinguishable from "nothing ever wanted this".
#
# So leave this off, read `consolidation_would_expire` in the logs for a few
# weeks, and set the thresholds from what you actually see:
#
#     python -m scripts.consolidate --user <id> --dry-run --decay --decay-after 30
#
DREAM_DREAM__CONSOLIDATION__DECAY_ENABLED=false
DREAM_DREAM__CONSOLIDATION__DECAY_AFTER_DAYS=90
# Importance at or above this is never decayed, however long it sits untouched.
DREAM_DREAM__CONSOLIDATION__DECAY_IMPORTANCE_FLOOR=0.5
# REQUIRED for decay: the date recall tracking began, as an ISO date. Empty
# disables decay outright whatever DECAY_ENABLED says - the cold-start guard,
# without which day one would expire the entire database in a single pass.
DREAM_DREAM__CONSOLIDATION__RECALL_EPOCH=

# --- Compaction (OFF - the only part that costs a model call) ----------------
# Folds crowds of near-identical low-value memories ("User ordered a dosa on a
# Tuesday", two hundred times) into one that says what they jointly say. Reuses
# MERGE, so every original stays readable with a `mergedInto` pointer.
#
# One model call per cluster, which is why it is gated on a user having enough
# clutter to be worth it. Nothing at or above the importance floor, nothing
# permanent, no pattern evidence and nothing recent is ever an input.
DREAM_DREAM__COMPACTION__ENABLED=false
DREAM_DREAM__COMPACTION__IMPORTANCE_FLOOR=0.4
DREAM_DREAM__COMPACTION__MIN_MEMORIES=40
DREAM_DREAM__COMPACTION__MIN_AGE_DAYS=30
DREAM_DREAM__COMPACTION__MAX_CLUSTERS_PER_RUN=5

# --- Domain ------------------------------------------------------------------
# One sentence describing what this deployment is. Injected into the extraction
# and decision prompts, costs ~30 tokens per call, and is the cheapest accuracy
# win available - it tells the model that "no onions" is a standing constraint
# rather than small talk, which no amount of generic rule-writing conveys.
#
# Leave empty for a general-purpose assistant.
DREAM_DOMAIN="A restaurant ordering assistant. Remember contact and delivery details, dietary needs, dislikes, and usual orders per meal."

# --- Vector store ------------------------------------------------------------
# faiss | memory
DREAM_VECTOR_PROVIDER=faiss
DREAM_FAISS_PATH=./data/faiss
DREAM_FAISS_MAX_LOADED_INDEXES=128

# --- Providers ---------------------------------------------------------------
# LLM and embeddings are chosen independently: Groq and Anthropic serve chat but
# not embeddings, so "Groq for chat, OpenAI for embeddings" is a normal pairing.
#
# LLM        azure_openai | openai | groq | ollama | together | fireworks
#            | openai_compatible | gemini | anthropic | fake
# Embedding  azure_openai | openai | ollama | openai_compatible | gemini | fake
DREAM_LLM_PROVIDER=azure_openai
DREAM_EMBEDDING_PROVIDER=azure_openai

# --- OpenAI-compatible endpoints ---------------------------------------------
# Shared by openai / groq / ollama / together / fireworks. Leave blank to accept
# the preset for the chosen provider. OPENAI_API_KEY is read too, so an already
# exported key needs no restating.
#
#   Fully local, no key, no cost:
#     DREAM_LLM_PROVIDER=ollama
#     DREAM_EMBEDDING_PROVIDER=ollama
#
#   Groq for chat, OpenAI for embeddings:
#     DREAM_LLM_PROVIDER=groq          GROQ_API_KEY=gsk_...
#     DREAM_EMBEDDING_PROVIDER=openai  OPENAI_API_KEY=sk-...
DREAM_OPENAI_API_KEY=
DREAM_OPENAI_BASE_URL=
DREAM_OPENAI_CHAT_MODEL=
DREAM_OPENAI_EMBEDDING_MODEL=
DREAM_OPENAI_EMBEDDING_DIMENSIONS=0

# --- Gemini ------------------------------------------------------------------
# pip install memdream[gemini]
# Does chat *and* embeddings, so it can be the only provider you configure:
#     DREAM_LLM_PROVIDER=gemini
#     DREAM_EMBEDDING_PROVIDER=gemini
# GEMINI_API_KEY and GOOGLE_API_KEY are read too, so an exported key needs no
# restating.
DREAM_GEMINI_API_KEY=
DREAM_GEMINI_CHAT_MODEL=gemini-2.0-flash
DREAM_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Matryoshka width. 768 keeps the per-write similarity search cheap.
DREAM_GEMINI_EMBEDDING_DIMENSIONS=768

# --- Anthropic ---------------------------------------------------------------
# pip install memdream[anthropic]
# Chat only — Anthropic has no embeddings API, so pair it with another provider:
#     DREAM_LLM_PROVIDER=anthropic        ANTHROPIC_API_KEY=sk-ant-...
#     DREAM_EMBEDDING_PROVIDER=openai     OPENAI_API_KEY=sk-...
DREAM_ANTHROPIC_API_KEY=
DREAM_ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Azure OpenAI ------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536

# --- Privacy -----------------------------------------------------------------
# Salt used when hashing phone numbers. Change it and existing hashes stop
# matching, so treat it as a long-lived secret.
DREAM_IDENTITY_SALT=change-me-to-a-long-random-string

# --- Observability -----------------------------------------------------------
DREAM_OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=dream-memory
